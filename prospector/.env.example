# Copy to .env on the server. Never commit .env.
DOMAIN=employee.example.ma
PUBLIC_URL=https://employee.example.ma
EMPLOYEE_KEY=                # long random string: protects the webhook and the cockpit
ANTHROPIC_API_KEY=
GHL_TOKEN=                   # GHL Private Integration token (SOGIXEL sub-account)
GHL_LOCATION_ID=
GHL_CALENDAR_ID=             # "Appel SOGIXEL" 15-minute calendar
GHL_OWNER_CONTACT_ID=        # Saad's own contact in GHL: receives notifications
GOOGLE_PLACES_API_KEY=
META_ADLIB_TOKEN=            # optional: past ads to Europe
