# Copy to .env on the server. Never commit .env. Check it with: docker compose exec employee python -m sogixel check --live
DOMAIN=employee.example.ma
PUBLIC_URL=https://employee.example.ma
SETTER_MODE=shadow           # shadow: replies come to you as drafts. live: replies go to prospects.
WEBHOOK_KEY=                 # 24+ random characters, used only in the GHL webhook URL
COCKPIT_KEY=                 # 24+ random characters, used only for the cockpit link
ANTHROPIC_API_KEY=
GHL_TOKEN=                   # GHL Private Integration token (SOGIXEL sub-account)
GHL_LOCATION_ID=
GHL_CALENDAR_ID=             # "Appel SOGIXEL" 15-minute calendar
GHL_OWNER_CONTACT_ID=        # your own contact in GHL: receives notifications
GOOGLE_PLACES_API_KEY=
META_ADLIB_TOKEN=            # optional: past ads to Europe
